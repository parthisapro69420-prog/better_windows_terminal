<Window x:Class="BetterWindowsTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="better_windows_terminal"
        Width="1100" Height="680"
        MinWidth="600" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Minimal rectangular tab style -->
        <Style x:Key="ChromeTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderThin}"
                                BorderThickness="1,1,1,0"
                                Padding="14,5,8,5"
                                Margin="0,0,2,0"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TabTitle"
                                           Text="{TemplateBinding Header}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource TerminalFont}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="CloseBtn"
                                        Content="×"
                                        Margin="10,0,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource TextMuted}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Click="CloseTab_Click"
                                        Padding="2,0,2,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource TabActiveBg}"/>
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain context menu style (no icons, no checkbox square) -->
        <Style x:Key="ShellMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBg" Background="Transparent" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBg" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#333333" CornerRadius="3" Margin="1"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer shell — no glow, no border radius drama -->
    <Border Background="{StaticResource GalaxyBg}" BorderThickness="0">
        <Grid>
            <!-- Animated particle canvas -->
            <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

            <DockPanel LastChildFill="True" Margin="0">

                <!-- Title bar — ultra minimal -->
                <Grid DockPanel.Dock="Top" Height="32" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sparkle new-tab button top-right -->
                    <Button x:Name="NewTabBtn"
                            Grid.Column="1"
                            Content="✦"
                            FontSize="16"
                            Foreground="{StaticResource TextPrimary}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Width="36" Height="32"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Click="NewTabBtn_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ShellMenu"
                                         HasDropShadow="False"
                                         ItemContainerStyle="{StaticResource ShellMenuItem}">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="#0A0A0A"
                                                BorderBrush="{StaticResource BorderThin}"
                                                BorderThickness="1"
                                                Padding="0,4">
                                            <StackPanel IsItemsHost="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <MenuItem Header="PowerShell" Click="NewTab_PowerShell"/>
                                <MenuItem Header="Command Prompt" Click="NewTab_Cmd"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Tab content area -->
                <TabControl x:Name="TerminalTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="6,0,6,0"
                            ItemContainerStyle="{StaticResource ChromeTabItem}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TabPanel Grid.Row="0"
                                          IsItemsHost="True"
                                          VerticalAlignment="Bottom"
                                          Margin="2,0,0,0"/>
                                <Border Grid.Row="1"
                                        Background="{StaticResource SurfaceBg}"
                                        BorderBrush="{StaticResource BorderThin}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>

            </DockPanel>
        </Grid>
    </Border>
</Window>
